
# ▃▃▃▃▃▃▃▃▃▃▃▃ Senso — development shop ▃▃▃▃▃▃▃▃▃▃▃▃
# These VITE_* values are public client configuration and are only read in
# development. In production Selldone injects the real shop, defaults and
# theme of whichever shop runs this Layout.

# Digini's public storefront name (from digini-hZGabLru.myselldone.com).
VITE_APP_SAMPLE_SHOP_NAME=digini-hzgablru

# The designed home in this Layout is the shop page.
# Values: blog | avocado | hyper | community | shop | map | <page id>
VITE_APP_SAMPLE_SHOP_CUSTOM_HOME=shop

VITE_APP_SAMPLE_DEFAULT_CURRENCY=USD
VITE_APP_SAMPLE_DEFAULT_COUNTRY=US
VITE_APP_SAMPLE_DEFAULT_LANGUAGE=en

# Senso palette: teal, near-black ink, white.
VITE_APP_SAMPLE_THEME_COLOR_LIGHT="#00736F"
VITE_APP_SAMPLE_THEME_COLOR_DARK="#0D1B1E"
VITE_APP_SAMPLE_THEME_COLOR_DEEP_DARK="#06100F"
VITE_APP_SAMPLE_THEME_COLOR_INFO="#00736F"

# ▃▃▃▃▃▃▃▃▃▃▃▃ Dev Server ▃▃▃▃▃▃▃▃▃▃▃▃

VITE_APP_DEV_SERVER_HOST=localhost
VITE_APP_DEV_SERVER_PORT=9133
VITE_APP_DEV_SERVER_HTTPS=FALSE
# The dev server shows the account design A ("desk").
# Releases set it themselves (release.sh <version> desk).
VITE_KALIO_ACCOUNT=desk
